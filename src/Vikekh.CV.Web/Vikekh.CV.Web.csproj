<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>3ab7dbe1-0173-438b-8823-17d02f63f195</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
		<PackageReference Include="NJsonSchema.CodeGeneration.CSharp" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Vikekh.JsonSchemaCSharpGenerator\Vikekh.JsonSchemaCSharpGenerator.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Interfaces\" />
	  <Folder Include="Services\" />
	</ItemGroup>

	<Target Name="GenerateJsonResumeModels" BeforeTargets="Build">
		<PropertyGroup>
			<JsonSchemaPath>.\jsonresume.schema.json</JsonSchemaPath>
			<DestinationPath>.\Models\JsonResume.g.cs</DestinationPath>
			<NS>Vikekh.CV.Web.Models</NS>
			<TypeNameHint>JsonResume</TypeNameHint>
		</PropertyGroup>
		<Exec Command="..\Vikekh.JsonSchemaCSharpGenerator\bin\$(Configuration)\net8.0\Vikekh.JsonSchemaCSharpGenerator.exe $(JsonSchemaPath) $(DestinationPath) $(NS) $(TypeNameHint)" />
	</Target>

</Project>
